# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/<database>

# Docker host for local development via SSH tunnel:
#   ssh -i <key> -N -L 127.0.0.1:2375:/var/run/docker.sock serverdashboard@<server>
# Omit in production (defaults to the local socket unix:///var/run/docker.sock).
DOCKER_HOST=tcp://localhost:2375

# Host directory below which bind mounts may be created (e.g. /srv/gameservers). Empty: bind mounts are disabled.
BIND_MOUNT_ROOT=

# First admin user, created on startup if no admin exists yet. Can be removed afterwards.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<at-least-12-characters>

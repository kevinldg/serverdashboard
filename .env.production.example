# Production configuration for docker-compose.yml. Copy to .env next to docker-compose.yml on the server.
# Never commit the real .env.

# Separate database for production (database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/serverdashboard?retryWrites=true&w=majority

# First admin user, created on the first start (when no admin exists yet)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<at-least-12-characters>

# Host directory below which bind mounts are allowed
BIND_MOUNT_ROOT=/home/<user>/docker

# Port on the server and group ID of the docker group (getent group docker)
DASHBOARD_PORT=8090
DOCKER_GID=996

# Optional: how long audit log entries are kept (default 365d)
# AUDIT_RETENTION=365d

# Git commit shown on the system information page (set during deployment)
GIT_COMMIT=unknown
